{
  "name": "nuance",
  "version": "0.1.0",
  "private": true,
  "description": "Photo-based food analysis and healthier swaps (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/verify-dist.mjs",
    "icons": "node scripts/icons.mjs",
    "screens": "node scripts/screens.mjs",
    "test:tz": "TZ=Australia/Sydney vitest run && TZ=Asia/Manila vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
